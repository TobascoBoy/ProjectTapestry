/.well-known/apple-app-site-association
  Content-Type: application/json

# Confirmation links carry a single-use auth token in the query string. Keep
# them out of caches and out of referrer headers sent to any third party.
# Globbed rather than the exact path: Netlify canonicalises /auth/confirm to
# /auth/confirm/ with a 301, and the rules must hold on both.
/auth/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# Friend-invite links (/f/<code>). The code is the invite's token and the
# sticker count changes while the invite is open: never cache, and never leak
# the path to the App Store / TestFlight as a referrer.
/f/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
